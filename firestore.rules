rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isManager() { return hasProfile() && profile().role == 'manager'; }
    function isDriver() { return hasProfile() && profile().role == 'driver'; }

    // حسابات المستخدمين: كل شخص يسجّل نفسه "بانتظار الموافقة"، والمدير فقط يغيّر الصلاحيات
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'pending';
      allow update, delete: if isManager();
    }

    // الطلبات: السايق يشوف ويعدّل طلباته فقط، والمدير يشوف الكل
    match /orders/{orderId} {
      allow read: if isManager() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver() && request.resource.data.driverId == request.auth.uid;
      allow update: if isManager() || (isDriver()
                    && resource.data.driverId == request.auth.uid
                    && request.resource.data.driverId == request.auth.uid);
      allow delete: if isManager();
    }

    // آخر موقع لكل سايق: السايق يكتب موقعه فقط، والمدير وحده يقرأ
    match /locations/{uid} {
      allow read: if isManager();
      allow write: if isDriver() && request.auth.uid == uid;
    }
  }
}
